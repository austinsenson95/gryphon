APP_NAME=Griffin
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
GRIFFIN_RUNTIME_MODE=browser
GRIFFIN_LOG_LEVEL=INFO

# LLM provider: "ollama" (local, default), "xai", or "openai_compatible".
# With neither configured, Griffin boots in deterministic mock mode.
LLM_PROVIDER=ollama

# Ollama (local model runtime)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=60

# xAI (Grok) provider
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# OpenAI-compatible fallback (OpenAI, LM Studio, etc.)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Speech-to-text: "local" (faster-whisper or whisper.cpp) or "disabled"
STT_PROVIDER=local
STT_MODEL=base
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL_PATH=

# Optional real web-search API (mock results otherwise)
SEARCH_API_KEY=
SEARCH_API_URL=
BROWSER_HEADLESS=false

# Browser automation (Phase 1 — Griffin-controlled browser)
BROWSER_GOTO_TIMEOUT_MS=15000
BROWSER_PROFILE_DIR=~/.griffin/browser-profile
BROWSER_SCREENSHOT_DIR=~/.griffin/browser-screenshots

# Agent loop rails (Phase 1)
# Allows multi-step observe -> act -> verify workflows while remaining bounded.
AGENT_MAX_STEPS=12
MAX_TOOL_RETRIES=2
TOOL_TIMEOUT=30

# Desktop execution safety rails (Phase 1)
DEFAULT_BROWSER=
ALLOWED_APPLICATIONS=Safari,Google Chrome,Firefox,Arc,Visual Studio Code,Terminal,iTerm,Notes,Calendar,Finder,Slack,Spotify
ALLOWED_DIRECTORIES=~/Projects,~/Documents,~/Desktop,~/Downloads
# JSON object mapping project aliases to paths:
PROJECTS={"griffin": "~/Projects/griffin"}
SEARCH_ENGINE_URL=https://www.google.com/search?q={query}
NEWS_SITES=https://news.ycombinator.com
RESEARCH_TOPIC=latest AI agent frameworks

DATABASE_URL=sqlite:///./griffin.db
GRIFFIN_DEV_TOKEN=
FRONTEND_ORIGIN=http://localhost:5173

# Outbound phone agent (leave blank for safe mock mode)
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_DID=
VOBIZ_BASE_URL=https://api.vobiz.ai/api/v1
PHONE_PUBLIC_URL=
PHONE_WEBHOOK_SECRET=
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
PHONE_LANGUAGE=en-IN
# JSON list, for example: [{"name":"Rahul","phone_number":"+919876543210","notes":"Friend"}]
PHONE_CONTACTS=
# Optional: reuse credentials directly from the Kimi phone-agent during migration.
PHONE_AGENT_ENV_FILE=
